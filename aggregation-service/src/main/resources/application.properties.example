spring.application.name=metamapa
# CronJob for collection refresh (every hour)
collection.refresh.cron=0 0 * * * *
#CornJob for reevaluate consensus
reevaluate.consensus.cron=0 0 3 * * *
# Agregation service port
server.port=
# Agregation service URL
aggregation-service.url=

# Database configuration
spring.datasource.url=
spring.datasource.username=
spring.datasource.password=
spring.datasource.driver-class-name=

# Hibernate configuration
# Possible values: validate | update | create | create-drop | none
spring.jpa.hibernate.ddl-auto=

spring.jpa.show-sql=
spring.jpa.properties.hibernate.format_sql=
spring.jpa.properties.hibernate.dialect=