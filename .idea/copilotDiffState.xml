              <option name="updatedContent" value="/**&#10; * Script de depuración para HTMX Infinite Scroll&#10; */&#10;&#10;document.addEventListener('DOMContentLoaded', function() {&#10;    console.log(' HTMX Debug Script cargado');&#10;    &#10;    // Verificar si HTMX está cargado&#10;    if (typeof htmx !== 'undefined') {&#10;        console.log('✅ HTMX está cargado correctamente');&#10;        console.log('   Versión:', htmx.version || 'No disponible');&#10;    } else {&#10;        console.error('❌ HTMX NO está cargado');&#10;        return;&#10;    }&#10;    &#10;    // Escuchar eventos de HTMX&#10;    document.body.addEventListener('htmx:beforeRequest', function(evt) {&#10;        console.log(' HTMX: Enviando petición', evt.detail);&#10;    });&#10;    &#10;    document.body.addEventListener('htmx:afterRequest', function(evt) {&#10;        console.log(' HTMX: Petición completada', {&#10;            status: evt.detail.xhr.status,&#10;            url: evt.detail.xhr.responseURL&#10;        });&#10;    });&#10;    &#10;    document.body.addEventListener('htmx:afterSettle', function(evt) {&#10;        console.log('✅ HTMX: Contenido insertado', evt.detail);&#10;    });&#10;    &#10;    document.body.addEventListener('htmx:responseError', function(evt) {&#10;        console.error('❌ HTMX: Error en respuesta', evt.detail);&#10;    });&#10;    &#10;    // Verificar el trigger&#10;    const trigger = document.querySelector('.htmx-scroll-trigger');&#10;    if (trigger) {&#10;        console.log('✅ Trigger encontrado:', trigger);&#10;        console.log('   Atributos HTMX:', {&#10;            'hx-get': trigger.getAttribute('hx-get'),&#10;            'hx-trigger': trigger.getAttribute('hx-trigger'),&#10;            'hx-swap': trigger.getAttribute('hx-swap')&#10;        });&#10;        &#10;        // Observar cuando el trigger sea visible&#10;        const observer = new IntersectionObserver((entries) =&gt; {&#10;            entries.forEach(entry =&gt; {&#10;                if (entry.isIntersecting) {&#10;                    console.log('️ Trigger es VISIBLE en el viewport');&#10;                } else {&#10;                    console.log(' Trigger NO es visible');&#10;                }&#10;            });&#10;        }, { threshold: 0.5 });&#10;        &#10;        observer.observe(trigger);&#10;    } else {&#10;        console.warn('⚠️ No se encontró el trigger de HTMX');&#10;    }&#10;    &#10;    // Verificar el contenedor .feed&#10;    const feed = document.querySelector('.feed');&#10;    if (feed) {&#10;        console.log('✅ Contenedor .feed encontrado');&#10;        console.log('   scrollHeight:', feed.scrollHeight);&#10;        console.log('   clientHeight:', feed.clientHeight);&#10;        console.log('   overflow-y:', window.getComputedStyle(feed).overflowY);&#10;    }&#10;});&#10;" />
            </PendingDiffInfo>
          </value>
        </entry>
