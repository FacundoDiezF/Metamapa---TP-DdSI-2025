server.port=8083

# Eureka Client Configuration
spring.application.name=static-source
eureka.client.service-url.defaultZone=http://localhost:8761/eureka/
eureka.client.enabled=false

# Database configuration
spring.datasource.url=jdbc:mysql://localhost:3306/metamapa_static?useSSL=false&serverTimezone=UTC&createDatabaseIfNotExist=true
spring.datasource.username=
spring.datasource.password=
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# Hibernate configuration
spring.jpa.hibernate.ddl-auto=create-drop
# Possible values: validate | update | create | create-drop | none
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQL8Dialect


# Import scheduler configuration
imports.fixed-delay-ms=60000

# File upload configuration (max file size)
spring.servlet.multipart.max-file-size=50MB

# Directory to store uploaded CSV files (from home directory)
static-source.storage.dir=metamapa/static-sources/csv