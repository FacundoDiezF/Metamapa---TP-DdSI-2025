# --- Server Configuration ---
server.port=8086

# --- Configuration Imports ---
spring.config.import=classpath:routes.yml

# --- Eureka Client configuration ---
spring.application.name=api-gateway
eureka.client.service-url.defaultZone=http://localhost:8761/eureka/

# --- JWT Configuration (RS256) ---
# Las claves hardcodeadas funcionan en desarrollo, pero en produccion deben ser provistas en las variables de entorno JWT_PRIVATE_KEY y JWT_PUBLIC_KEY
app.jwt.public-key=${JWT_PUBLIC_KEY:}