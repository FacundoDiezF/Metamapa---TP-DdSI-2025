# --- Server Configuration ---
server.port=8087

# Eureka Client configuration
spring.application.name=user-service
eureka.client.service-url.defaultZone=http://localhost:8761/eureka/
eureka.instance.prefer-ip-address=true
eureka.client.enabled=false

# --- Database Configuration ---
spring.datasource.url=jdbc:mysql://localhost:3306/metamapa_users?useSSL=false&serverTimezone=UTC&createDatabaseIfNotExist=true
spring.datasource.username=
spring.datasource.password=
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# Hibernate configuration
spring.jpa.hibernate.ddl-auto=create-drop
# Possible values: validate | update | create | create-drop | none
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQL8Dialect

# --- JWT Configuration (RS256) ---
# Las claves hardcodeadas funcionan en desarrollo, pero en produccion deben ser provistas en las variables de entorno JWT_PRIVATE_KEY y JWT_PUBLIC_KEY
app.jwt.private-key=${JWT_PRIVATE_KEY:}
app.jwt.public-key=${JWT_PUBLIC_KEY:}
app.jwt.expiration-minutes=15
app.jwt.refresh-expiration-minutes=1440
