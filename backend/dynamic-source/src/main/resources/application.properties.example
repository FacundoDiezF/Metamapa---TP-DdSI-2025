server.port=8081

#File Upload Configuration
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=50MB
app.event.max-images=5

# Eureka Client Configuration
spring.application.name=dynamic-source
eureka.client.service-url.defaultZone=http://localhost:8761/eureka/
eureka.client.enabled=true

# Database configuration
spring.datasource.url=jdbc:mysql://localhost:3306/metamapa_dynamic?useSSL=false&serverTimezone=UTC&createDatabaseIfNotExist=true
spring.datasource.username=
spring.datasource.password=
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# Hibernate configuration
spring.jpa.hibernate.ddl-auto=create-drop

# Possible values: validate | update | create | create-drop | none
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQL8Dialect

# Object Storage Configuration (S3 API)
aws.s3.endpoint=http://localhost:9000
#! Posiblemente haya que cambiar de regiónal hacer el despliegue, pero para minIO no importa
aws.s3.region=us-east-1
aws.s3.access-key=admin
aws.s3.secret-key=12345678
aws.s3.bucket-name=metamapa-media
#! IMPORTANTE: MinIO necesita 'path-style' (http://host/bucket), AWS usa virtual-host, asi que al desplegar puede ser necesario cambiarla a flase, dependiendo de la plataforma
aws.s3.path-style-access=true